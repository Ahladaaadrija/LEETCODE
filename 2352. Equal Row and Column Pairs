class Solution:
    def equalPairs(self, grid: list[list[int]]) -> int:
        row = len(grid)
        column = len(grid[0])
        rows = []
        for i in range(column):
            value = []
            for j in range(row):
                value.append(grid[j][i])
            rows.append(value)
        
        c = 0
        for i in rows:
            for j in grid:
                if i == j:
                    c+=1
    
        return c
