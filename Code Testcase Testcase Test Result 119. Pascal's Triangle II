class Solution:
    def getRow(self, rowIndex: int) -> list[int]:
        n = rowIndex
        n += 1
        if n == 0:
            p = []
            return p
        elif n == 1:
            p = [1]
            return p
        elif n == 2:
            p = [1,1]
            return p
        elif n > 2:
            p = [[1],[1,1]]
            n = n - 2
            for i in range(n):
                s = p[-1]
                m = len(s)
                k = []
                k.append(1)
                j = 0
                summ = 0
                while  j < m-1:
                    summ = s[j] + s[j+1]
                    k.append(summ)
                    j += 1
                k.append(1)
                p.append(k)
            return p[-1]
