class Solution:
    def smallestIndex(self, nums: List[int]) -> int:
        n = len(nums)
        for i in range(n):
            temp = nums[i]
            summ = 0
            while temp != 0:
                k = temp % 10
                summ = summ + k
                temp = temp//10
            if summ == i:
                return i
        return -1
        
