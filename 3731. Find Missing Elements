class Solution:
    def findMissingElements(self, nums: List[int]) -> List[int]:
        nums.sort()
        n = len(nums)
        p = []
        a = nums[0]
        b = nums[-1]
        for i in range(a,b+1):
            if i not in nums:
                p.append(i)       

        return p
            


        
