class Solution:
    def countDaysTogether(self, arriveAlice: str, leaveAlice: str,
                          arriveBob: str, leaveBob: str) -> int:

        days = [31, 28, 31, 30, 31, 30,
                31, 31, 30, 31, 30, 31]

        def convert(date):
            month, day = map(int, date.split("-"))

            total = day

            for i in range(month - 1):
                total += days[i]

            return total

        astart = convert(arriveAlice)
        aend = convert(leaveAlice)

        bstart = convert(arriveBob)
        bend = convert(leaveBob)

        start = max(astart, bstart)
        end = min(aend, bend)

        if start > end:
            return 0

        return end - start + 1
