class Solution:
    def twoSum(self, numbers: list[int], target: int) -> list[int]:
        i = 0
        n = len(numbers)
        j = n-1
        out = []
        while i<j:
            k =  numbers[i] + numbers[j]
            if k > target:
                j -=1
            elif k < target:
                i += 1
            elif k == target:
                first = i+1
                second = j + 1
                out.append(first)
                out.append(second)
                break
        return out 

        
