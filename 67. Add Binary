class Solution:
    def addBinary(self, a: str, b: str) -> str:
        newa = list(a)
        newb = list(b)
        lena = len(newa)
        lenb = len(newb)
        newa.reverse()
        newb.reverse()
        out = []
        temp = 0
        i = 0
        j = 0
        while i < lena and j <lenb:
            ii = newa[i]
            jj = newb[j]
            if ii == "0" and jj == "0":
                if temp == 1:
                    out.append('1')
                elif temp == 0:
                    out.append("0")
                temp = 0
            elif ii == "1" and jj == "0":
                if temp == 1:
                    out.append("0")
                    temp = 1
                elif temp == 0:
                    out.append("1")
                    temp = 0
            elif ii == "0" and jj == "1":
                if temp == 1:
                    out.append("0")
                    temp = 1
                elif temp == 0:
                    out.append("1")
                    temp = 0
            elif ii == "1" and jj == "1":
                if temp == 1:
                    out.append("1")
                    temp = 1
                elif temp == 0:
                    out.append("0")
                    temp = 1
            i += 1
            j += 1
        while i < lena:
            if temp == 1 and newa[i] == "1":
                out.append("0")
                temp = 1
            elif temp == 1 and newa[i] == "0":
                out.append("1")
                temp = 0
            elif temp == 0 and newa[i] == "1":
                out.append("1")
                temp = 0
            else:
                out.append("0")

            i += 1

        while j < lenb:
            if temp == 1 and newb[j] == "1":
                out.append("0")
                temp = 1
            elif temp == 1 and newb[j] == "0":
                out.append("1")
                temp = 0
            elif temp == 0 and newb[j] == "1":
                out.append("1")
                temp = 0
            else:
                out.append("0")

            j += 1

        if temp == 1:
            out.append("1")

        out.reverse()

        news = "".join(out)
        return news

