class Solution:
    def pairSum(self, head: ListNode | None) -> int:
        curr = head
        p = []
        c = 0
        while curr:
            i = curr.val
            p.append(i)
            curr = curr.next
            c+=1
        
        p.reverse()
        n = len(p)
        if n<=1:
            return p[0]
        elif n>=2:
            k = 0
            i = 0
            j = n-1
            while i<j:
                temp = p[i]+p[j]
                k = max(temp,k)
                i+=1
                j-=1
            return k
