# Definition for singly-linked list.
# class ListNode:
#     def __init__(self, val=0, next=None):
#         self.val = val
#         self.next = next
class Solution:
    def removeNthFromEnd(self, head: ListNode | None, n: int) -> ListNode | None:
        cur = head
        c = 0
        while cur:
            c += 1
            cur = cur.next
        if c == 1:
            return None
        elif n == c:
            head = head.next
            return head
        
        n = c - n
        k = 0
        cur = head
        prev = head
        while cur.next and k < n:
            prev = cur
            cur = cur.next
            k += 1
        prev.next = cur.next 
        return head
            



        
        
