class Solution:
    def romanToInt(self, s: str) -> int:
        chart = {"I":1,"V":5,"X":10,"L":50,"C":100,"D":500,"M":1000}
        p = 0
        k = []
        for i in s:
            if i in chart:
                k.append(chart[i])
                n = len(k)
                if k[n-1] > k[n-2]:
                    j = k.pop()
                    o = k.pop()
                    r = j-o
                    k.append(r)
        for t in k:
            p = p + t
        return p
        
