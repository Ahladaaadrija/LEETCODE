class Solution:
    def minMoves(self, nums: list[int]) -> int:
        n = len(nums)
        if n == 0 or n == 1:
            return 0
        else:
            k = len(set(nums))
            if k <= 1:
                return 0
            c = 0
            p = []
            dont = min(nums)
            for i in nums:
                if i != dont:
                   p.append(i)
            
            
            for i in p:
                c += i - dont
            
            return c

   
