class Solution:

    def generate(self, numRows: int) -> list[list[int]]:
        n = numRows
        p = []
        if n == 0:
            return p
        elif n == 1:
            p = [[1]]
            return p
        elif n == 2:
            p = [[1],[1,1]]
            return p
        elif n > 2:
            p = [[1],[1,1]]
            n = n - 2
            for i in range(n):
                k = [1]
                s = p[-1]
                f = 0
                m = len(s)
                while f < m-1:
                    summ = s[f] + s[f+1]
                    k.append(summ)
                    f+=1
                k.append(1)
                p.append(k)
                
            return p 
