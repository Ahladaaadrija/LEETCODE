class Solution:
    def maxProfit(self, prices: list[int]) -> int:
        summ = 0
        n = len(prices)
        if n == 1:
            return 0
        else:
            p = []
            i = 0
            while i < n-1:
                k = i+1
                if prices[i] < prices[k]:
                    new = prices[k] - prices[i]
                    p.append(new)
                i += 1
                
            summ = sum(p)
            return summ

